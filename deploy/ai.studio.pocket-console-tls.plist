<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>POCKET_CONSOLE_TLS_BIND</key>
		<string>100.67.0.12</string>
		<key>POCKET_CONSOLE_TLS_PORT</key>
		<string>8443</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.studio.pocket-console-tls</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/xcash/.local/bin/pocket-console-tls.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/xcash/Library/Logs/pocket-console-tls.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/xcash/Library/Logs/pocket-console-tls.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>/Users/xcash</string>
</dict>
</plist>
